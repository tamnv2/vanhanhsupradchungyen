<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VHDCHY LAN BETA PILOT — FULL TEST"
            android:textStyle="bold"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/deviceInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Transport: khởi tạo..."
            android:textStyle="bold"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/lanPriority"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="LAN priority: đang khởi tạo..."
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LAN priority = khi Agent BETA hợp lệ xuất hiện, app chủ động ưu tiên LAN. Dùng để test laptop bật/restart thì PDA tự quay về LAN mà không nhập IP."
            android:textSize="12sp" />

        <TextView
            android:id="@+id/endpoint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textIsSelectable="true" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minLines="4"
            android:textIsSelectable="true" />

        <Button
            android:id="@+id/discover"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Tìm LAN ngay" />

        <Button
            android:id="@+id/echo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Test Echo / Latency" />

        <Button
            android:id="@+id/event"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gửi test event durable" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Realtime PDA ↔ Laptop ↔ PDA"
            android:textStyle="bold"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/realtimeStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Realtime: đang chờ dữ liệu..."
            android:textIsSelectable="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Khi một PDA gửi realtime, laptop dashboard và PDA còn lại nhận qua long-poll. App đo số bản tin, độ trễ hiển thị p95 và sequence gap."
            android:textSize="12sp" />

        <Button
            android:id="@+id/realtimeOne"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gửi 1 bản tin realtime" />

        <Button
            android:id="@+id/realtimeHeavy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Realtime nặng: 200 bản tin × 2 KB" />

        <TextView
            android:id="@+id/testStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Test realtime: chưa chạy"
            android:textIsSelectable="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Truyền tải dữ liệu"
            android:textStyle="bold"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/transferStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Transfer: chưa chạy"
            android:textIsSelectable="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Đo upload và download PDA ↔ laptop bằng dữ liệu test, hiển thị Mbps và thời gian hoàn thành."
            android:textSize="12sp" />

        <Button
            android:id="@+id/transfer1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Test truyền 1 MB" />

        <Button
            android:id="@+id/transfer25"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Test truyền nặng 25 MB" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Bộ test PDA đầy đủ"
            android:textStyle="bold"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/suiteStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="FULL SUITE: chưa chạy"
            android:textIsSelectable="true" />

        <Button
            android:id="@+id/fullSuite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chạy FULL SUITE: 100 echo + 1/10/25MB + realtime nặng" />

        <Button
            android:id="@+id/fullExport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Xuất FULL diagnostics" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="FULL diagnostics gồm kết quả LAN priority, realtime, transfer, suite và log nền để gửi vào chat VHDCHY phân tích."
            android:textSize="12sp" />

        <Button
            android:id="@+id/exportLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Xuất log chẩn đoán cơ bản" />

        <Button
            android:id="@+id/update"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kiểm tra cập nhật" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Manual LAN recovery / chẩn đoán"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/manualEndpoint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ví dụ: http://192.168.1.25:17891"
            android:inputType="textUri"
            android:singleLine="true" />

        <Button
            android:id="@+id/saveEndpoint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lưu endpoint thủ công" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chỉ dùng manual endpoint khi cần phân loại lỗi discovery. Vận hành bình thường không phụ thuộc IP nhập tay."
            android:textSize="12sp" />

        <TextView
            android:id="@+id/queue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Pending local queue: 0" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pilot chỉ dùng test payload, chưa dùng credential hay dữ liệu nghiệp vụ thật."
            android:layout_marginTop="18dp" />
    </LinearLayout>
</ScrollView>
